{
  "extends": "@sber-orm/tsconfig-config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vitest/globals"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-mfe",
    "src/App.tsx",
    "src/components/NormPrototype.tsx"
  ]
}
